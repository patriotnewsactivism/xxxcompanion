# ============================================================================
# Companion — environment template
# Copy to .env.local (and mirror in Vercel project env for production).
# ============================================================================

# --- Database (Supabase Postgres via Drizzle + postgres-js) ----------------
# REQUIRED — the app throws at import time if DATABASE_URL is unset.
#
# Supabase offers two connection modes:
#   * TRANSACTION POOLER (recommended for serverless/Vercel, connection
#     scaling with a small pool):
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   * DIRECT connection (recommended for local drizzle-kit / long-lived
#     connections / migrating):
#     postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# Use the pooler URI for the app, the direct URI when running migrations
# (bun run db:migrate) or drizzle-kit generate locally.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Adult-first chat provider (highest priority slot, optional) -----------
# Any OpenAI-compatible endpoint the operator trusts for adult content
# (e.g. https://api.venice.ai/api/v1 with model dolphin-mistral-24b).
# The adult slot is only included when ADULT_CHAT_API_KEY is set.
ADULT_CHAT_ENDPOINT=
ADULT_CHAT_API_KEY=
ADULT_CHAT_MODEL=dolphin-mistral-24b

# --- OpenAI-compatible fallback providers (priority order) -----------------
# Slot 1 is the uncensored Venice edition of dolphin-mistral-24b when set.
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=

# --- External safety classifier (legality-only moderation) -----------------
MODERATION_API_URL=
MODERATION_API_KEY=

# --- Embeddings (RAG / memory retrieval) -----------------------------------
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# --- Voice, image, and video synthesis -------------------------------------
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
STABILITY_API_KEY=
AVATAR_SYNTHESIS_API_KEY=

# --- Age verification (Veriff) ---------------------------------------------
VERIFF_API_KEY=
VERIFF_SECRET_KEY=
VERIFF_CALLBACK_URL=
# --- Surge embed bridge (premium "AI Companion" tab in Hookup-Radar) --------
# When set, the /embed entry + /api/bridge flow activates, letting the
# companion run inside Surge's premium-gated tab without cookies.
# Comma-separated list of Surge origins allowed to embed + hand us tokens.
NEXT_PUBLIC_EMBED_PARENT_ORIGIN=
# HMAC secret for companion bearer tokens (openssl rand -hex 32).
BRIDGE_SESSION_SECRET=
# Surge's Supabase project (URL + anon key only — no service role needed;
# premium checks ride the user's own JWT).
SURGE_SUPABASE_URL=
SURGE_SUPABASE_ANON_KEY=

# --- Voice engine (premium voice mode) -------------------------------------
# Gemini 2.5 Flash TTS/STT — primary voice provider. Synthesizes explicit
# text with natural-language acting directions (verified 2026-09-06).
GEMINI_API_KEY=
# Grok TTS fallback — plain synthesis, no content gating (verified 2026-09-06).
XAI_API_KEY=
